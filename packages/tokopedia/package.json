{
  "name": "@kentandrian/tokopedia-mcp",
  "version": "0.1.0",
  "description": "Tokopedia MCP server powered by Tokopedia's public GraphQL gateway",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KenTandrian/mcp-servers.git",
    "directory": "packages/tokopedia"
  },
  "homepage": "https://github.com/KenTandrian/mcp-servers/tree/main/packages/tokopedia#readme",
  "bugs": {
    "url": "https://github.com/KenTandrian/mcp-servers/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "tokopedia-mcp": "./build/index.js"
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test test/*.test.ts",
    "test:smoke": "tsx test/smoke.ts",
    "test": "pnpm test:unit",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@kentandrian/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  }
}
