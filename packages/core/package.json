{
  "name": "@mcp-servers/core",
  "version": "0.1.0",
  "description": "Shared HTTP, caching, and MCP tool utilities for mcp-servers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KenTandrian/mcp-servers.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/KenTandrian/mcp-servers/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/KenTandrian/mcp-servers/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test test/*.test.ts",
    "test": "pnpm test:unit",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\""
  }
}
