{
  "name": "@kentandrian/id-news-mcp",
  "version": "0.1.0",
  "description": "Indonesian news and tech digest MCP server powered by CNBC Indonesia, Antara, and Tempo RSS feeds",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "indonesia",
    "news",
    "berita",
    "rss",
    "cnbc-indonesia",
    "antara",
    "tempo",
    "southeast-asia"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KenTandrian/mcp-servers.git",
    "directory": "packages/id-news"
  },
  "homepage": "https://github.com/KenTandrian/mcp-servers/tree/main/packages/id-news#readme",
  "bugs": {
    "url": "https://github.com/KenTandrian/mcp-servers/issues"
  },
  "mcpName": "io.github.KenTandrian/id-news-mcp",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "id-news-mcp": "./build/index.js"
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test test/*.test.ts",
    "test:smoke": "tsx test/smoke.ts",
    "test": "pnpm test:unit",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@kentandrian/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  }
}
